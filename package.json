{
  "name": "tackbox",
  "version": "0.1.0",
  "description": "ESLint and Markdown lint plugins, an Oh My Pi extension, plus direct error-reporting helpers for JavaScript and TypeScript.",
  "license": "MIT",
  "main": "./js/eslint-plugin.js",
  "exports": {
    ".": "./js/eslint-plugin.js",
    "./report/browser": {
      "types": "./js/report/browser.d.mts",
      "default": "./js/report/browser.mjs"
    },
    "./report/node": {
      "types": "./js/report/node.d.mts",
      "default": "./js/report/node.mjs"
    }
  },
  "bin": {
    "tackbox-codex-hook": "./bin/tackbox-codex-hook.js",
    "tackbox-eslint": "./bin/tackbox-eslint.js",
    "tackbox-mdlint": "./bin/tackbox-mdlint.js"
  },
  "omp": {
    "extensions": [
      "./js/omp/index.mjs"
    ]
  },
  "files": [
    "js/eslint-plugin.js",
    "js/report/",
    "js/rules/",
    "js/markdownlint-rules/",
    "js/codex/",
    "js/omp/index.mjs",
    "js/omp/index.js",
    "js/omp/hook.js",
    "js/omp/payload.js",
    "js/README.md",
    "bin/",
    "eslint.config.preset.js"
  ],
  "scripts": {
    "test": "node --test js/tests/*.test.js"
  },
  "peerDependencies": {
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "eslint": ">=8"
  },
  "peerDependenciesMeta": {
    "@sentry/browser": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "markdownlint": "0.40.0",
    "svelte": "^5.0.0",
    "svelte-eslint-parser": "^1.6.0"
  },
  "devDependencies": {
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "eslint": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nikitatsym/tackbox.git"
  },
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  }
}
